{
  "name": "grapevine",
  "version": "0.1.0",
  "private": true,
  "description": "Replay a Slack workspace as a living force-directed graph. Runs entirely in the browser.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/danielgwilson/grapevine"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src"
  },
  "dependencies": {
    "@fontsource-variable/anybody": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "fflate": "^0.8.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
